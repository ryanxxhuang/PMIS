# W6-1：只填臨時／隔離的 Supabase staging，正式專案 URL 會被設定檔拒絕。
E2E_REAL_SUPABASE_URL=https://<staging-project-ref>.supabase.co
E2E_REAL_SUPABASE_ANON_KEY=<staging-publishable-key>
# W6-2 起的鏈測試建立/清理 fixture 帳號用;只填 staging 的 key
E2E_REAL_SERVICE_ROLE_KEY=<staging-service-role-key>
E2E_REAL_EMAIL=w6-smoke@example.test
E2E_REAL_PASSWORD=<staging-test-account-password>
