// 線上 demo 站(pmis-demo Worker)的部署設定。與正式站共用同一份程式與 assets 設定,
// 只差名稱與自訂網域;分開一個檔是為了讓 Workers Builds 的正式 `pmis` 不會吃到 demo 的 routes。
// 建置時 Supabase／Sentry 環境變數留空 → demo 模式(三角色選人登入、記憶體種子)。
// 重佈:VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= VITE_SENTRY_DSN= npm run build && npx wrangler deploy --config wrangler.demo.jsonc
{
  "name": "pmis-demo",
  "compatibility_date": "2026-08-11",
  "routes": [{ "pattern": "demo.gov-agent.ai", "custom_domain": true }],
  // workers.dev 網址保留當備援(已對外給過),主網址是 demo.gov-agent.ai
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
